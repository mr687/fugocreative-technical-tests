# Replace credentials/database for your setup.
DATABASE_URL=postgres://user:password@localhost:5432/fugocreative?sslmode=disable

# Admin login credentials; use a unique, strong password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-output-of-openssl-rand-base64-32
# JWT lifetime as Go duration, e.g. 1h or 30m.
JWT_TTL=1h

# LLM provider configuration; use provider/model names supported by implementation.
LLM_PROVIDER=
LLM_MODEL=
# API key issued by your LLM provider. Keep secret; never commit real value.
LLM_API_KEY=
# Base URL/endpoint for provider API, e.g. https://api.example.com/v1.
LLM_ENDPOINT=
# Provider request timeout as Go duration, e.g. 30s.
LLM_TIMEOUT=30s

# HTTP listen address, e.g. :8080.
SERVER_ADDR=:8080
# Exact frontend origin allowed by CORS, e.g. https://app.example.com.
CORS_ALLOWED_ORIGIN=http://localhost:3000
